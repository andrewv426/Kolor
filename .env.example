# color-gradle environment.
#
# LOCAL MODE: if these values are missing OR left as the placeholders below,
# the app runs fully without Supabase — lib/data falls back to the LocalAdapter
# (localStorage + a seeded gallery). Fill in real values to switch to the
# SupabaseAdapter. Copy this file to .env.local for development.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
